<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AccountingSystem.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccountingSystem.Core\AccountingSystem.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- مهاجرت‌ها در اسمبلی جاسازی می‌شوند تا برنامه‌ی وب و ویندوز بدون فایل جداگانه ارتقا دهند. -->
    <EmbeddedResource Include="..\..\database\migrations\*.sql" LogicalName="migrations/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
