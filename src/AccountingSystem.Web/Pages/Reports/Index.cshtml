@page
@model IndexModel
@{
    ViewData["Title"] = "گزارش‌ها";
}

<h1>گزارش‌ها</h1>
<p class="hint">گزارش سرفصل‌ها با مانده تا تاریخ یا گردش بازه‌ای در دسترس است. برای گروه، کل یا معین می‌توانید بین ثبت مستقیم و تجمیع زیرحساب‌ها انتخاب کنید. معین صندوق‌ها و حساب‌های بانکی نیز گردش هر حساب را به تفکیک ارز نشان می‌دهد.</p>

@if (!string.IsNullOrWhiteSpace(Model.Notice))
{
    <div class="alert">@Model.Notice</div>
}
@if (!string.IsNullOrWhiteSpace(Model.RangeError))
{
    <div class="alert error">@Model.RangeError</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert error">@Model.ErrorMessage</div>
}

<form method="get" class="panel form-grid report-filters" id="report-filter-form">
    <label>نوع گزارش
        <select name="ReportType" id="ReportType">
            <option value="BALANCES" selected="@(Model.IsBalancesReport)">مانده اشخاص</option>
            <option value="LEDGER" selected="@(Model.IsCustomerLedgerReport)">معین شخص</option>
            <option value="ACCOUNT" selected="@(Model.IsAccountReport)">گزارش سرفصل حساب</option>
            <option value="CASHBOX" selected="@(Model.IsCashBoxReport)">معین صندوق‌ها</option>
            <option value="BANK" selected="@(Model.IsBankReport)">معین حساب‌های بانکی</option>
        </select>
    </label>
    <label>شعبه
        <select name="BranchFilter">
            @if (User.IsInRole("Admin"))
            {
                <option value="" selected="@(Model.BranchFilter is null)">همه‌ی شعبه‌ها</option>
            }
            @foreach (var branch in Model.Branches)
            {
                <option value="@branch.Id" selected="@(Model.BranchFilter == branch.Id)">@branch.Code - @branch.Name</option>
            }
        </select>
    </label>

    <label class="report-filter" data-report-types="BALANCES">
        مانده اشخاص تا تاریخ (شمسی)
        <input name="AsOf" value="@Model.AsOf" dir="ltr" placeholder="۱۴۰۵/۰۷/۱۵" />
    </label>
    <label class="report-filter" data-report-types="LEDGER">
        شخص
        <select name="CustomerId">
            <option value="">— انتخاب شخص —</option>
            @foreach (var customer in Model.Customers)
            {
                <option value="@customer.Id" selected="@(Model.CustomerId == customer.Id)">@customer.FullName · @customer.CustomerCode</option>
            }
        </select>
    </label>
    <label class="report-filter" data-report-types="ACCOUNT">
        سرفصل (هر سطح)
        <select name="AccountCode">
            <option value="">— انتخاب سرفصل —</option>
            @foreach (var account in Model.Accounts)
            {
                var indent = new string('　', Math.Max(0, account.Level - 1));
                <option value="@account.Code" selected="@(Model.AccountCode == account.Code)">@indent@account.Code · @account.Name (سطح @account.Level)</option>
            }
        </select>
    </label>
    <label class="report-filter check-field" data-report-types="ACCOUNT">
        <input type="checkbox" name="IncludeDescendants" value="true" checked="@(Model.IncludeDescendants)" />
        <input type="hidden" name="IncludeDescendants" value="false" />
        تجمیع گردش و مانده‌ی زیرحساب‌ها
    </label>
    <label class="report-filter" data-report-types="CASHBOX">
        صندوق
        <select name="CashBoxId">
            <option value="">همه‌ی صندوق‌ها</option>
            @foreach (var box in Model.CashBoxes)
            {
                <option value="@box.Id" selected="@(Model.CashBoxId == box.Id)">@box.BranchName · @box.Name · @box.CurrencyCode</option>
            }
        </select>
    </label>
    <label class="report-filter" data-report-types="BANK">
        حساب بانکی
        <select name="BankAccountId">
            <option value="">همه‌ی حساب‌های بانکی</option>
            @foreach (var account in Model.BankAccounts)
            {
                <option value="@account.Id" selected="@(Model.BankAccountId == account.Id)">@account.BranchName · @account.Name · @account.CurrencyCode</option>
            }
        </select>
    </label>
    <label class="report-filter" data-report-types="ACCOUNT,CASHBOX,BANK">
        شکل گزارش
        <select name="DateMode" id="DateMode">
            <option value="ASOF" selected="@(!Model.IsDateRange)">مانده تا یک تاریخ</option>
            <option value="RANGE" selected="@(Model.IsDateRange)">گردش از/تا</option>
        </select>
    </label>
    <label class="report-filter" data-report-types="ACCOUNT,CASHBOX,BANK" data-date-modes="ASOF">
        مانده تا تاریخ (شمسی)
        <input name="AsOf" value="@Model.AsOf" dir="ltr" placeholder="۱۴۰۵/۰۷/۱۵" />
    </label>
    <label class="report-filter" data-report-types="LEDGER,ACCOUNT,CASHBOX,BANK" data-date-modes="RANGE">
        از تاریخ (شمسی)
        <input name="From" value="@Model.From" dir="ltr" placeholder="۱۴۰۵/۰۷/۰۱" />
    </label>
    <label class="report-filter" data-report-types="LEDGER,ACCOUNT,CASHBOX,BANK" data-date-modes="RANGE">
        تا تاریخ (شمسی)
        <input name="To" value="@Model.To" dir="ltr" placeholder="۱۴۰۵/۰۷/۳۰" />
    </label>
    <div class="report-actions">
        <button type="submit">نمایش گزارش</button>
        <button type="submit" class="secondary" asp-page-handler="Excel">خروجی Excel</button>
    </div>
</form>

@if (Model.IsBalancesReport)
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>کد شخص</th><th>نام شخص</th><th>مانده بدهکار (ریال)</th><th>مانده بستانکار (ریال)</th><th>وضعیت</th><th>معین</th></tr>
            </thead>
            <tbody>
                @if (Model.Balances.Count == 0)
                {
                    <tr><td colspan="6">موردی برای نمایش نیست.</td></tr>
                }
                @foreach (var balance in Model.Balances)
                {
                    <tr>
                        <td>@balance.CustomerCode</td>
                        <td>@balance.FullName</td>
                        <td>@MoneyMath.FormatAmount(balance.DebitBalanceIrr, 0)</td>
                        <td>@MoneyMath.FormatAmount(balance.CreditBalanceIrr, 0)</td>
                        <td>@balance.BalanceSide</td>
                        <td><a class="link small" asp-page="/Reports/Index" asp-route-reportType="LEDGER" asp-route-customerId="@balance.CustomerId" asp-route-branchFilter="@Model.BranchFilter">مشاهده‌ی معین</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="hint">تعداد اشخاص: @Model.Balances.Count · مجموع مانده‌های بدهکار: @MoneyMath.FormatAmount(Model.Balances.Sum(x => x.DebitBalanceIrr), 0) ریال · مجموع مانده‌های بستانکار: @MoneyMath.FormatAmount(Model.Balances.Sum(x => x.CreditBalanceIrr), 0) ریال</p>
}
else if (Model.IsCustomerLedgerReport && Model.Ledger is { } ledger)
{
    <section class="panel report-summary">
        <strong>@ledger.Customer.FullName · @ledger.Customer.CustomerCode</strong>
        <span>مانده‌ی ابتدای دوره: @MoneyMath.FormatAmount(Math.Abs(ledger.OpeningBalanceIrr), 0) ریال @(ledger.OpeningBalanceIrr > 0 ? "بدهکار" : ledger.OpeningBalanceIrr < 0 ? "بستانکار" : "تسویه")</span>
        <span>مانده‌ی پایان دوره: @MoneyMath.FormatAmount(Math.Abs(ledger.ClosingBalanceIrr), 0) ریال @(ledger.ClosingBalanceIrr > 0 ? "بدهکار" : ledger.ClosingBalanceIrr < 0 ? "بستانکار" : "تسویه")</span>
    </section>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>زمان</th><th>شعبه</th><th>شماره سند</th><th>منشأ</th><th>شرح</th><th>معین</th><th>بدهکار (ریال)</th><th>بستانکار (ریال)</th><th>مانده</th></tr>
            </thead>
            <tbody>
                <tr class="summary-row">
                    <td colspan="6">مانده‌ی ابتدای دوره</td>
                    <td>@MoneyMath.FormatAmount(Math.Max(0m, ledger.OpeningBalanceIrr), 0)</td>
                    <td>@MoneyMath.FormatAmount(Math.Max(0m, -ledger.OpeningBalanceIrr), 0)</td>
                    <td>@MoneyMath.FormatAmount(Math.Abs(ledger.OpeningBalanceIrr), 0) @(ledger.OpeningBalanceIrr > 0 ? "بدهکار" : ledger.OpeningBalanceIrr < 0 ? "بستانکار" : "")</td>
                </tr>
                @if (ledger.Lines.Count == 0)
                {
                    <tr><td colspan="9">در این بازه گردش ثبت نشده است.</td></tr>
                }
                @foreach (var line in ledger.Lines)
                {
                    <tr>
                        <td>@PersianDate.FormatDateTime(line.OccurredAt)</td>
                        <td>@line.BranchName</td>
                        <td>@line.JournalEntryId</td>
                        <td>@IndexModel.SourceText(line.SourceType)</td>
                        <td>@(line.IsVoided ? "[باطل‌شده] " : "")@line.Description</td>
                        <td>@line.AccountCode</td>
                        <td>@MoneyMath.FormatAmount(line.Debit, 0)</td>
                        <td>@MoneyMath.FormatAmount(line.Credit, 0)</td>
                        <td>@MoneyMath.FormatAmount(Math.Abs(line.BalanceIrr), 0) @(line.BalanceIrr > 0 ? "بدهکار" : line.BalanceIrr < 0 ? "بستانکار" : "تسویه")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (Model.IsCustomerLedgerReport && Model.CustomerId is null)
{
    <div class="alert">برای دیدن معین، شخص را انتخاب کنید.</div>
}
else if (Model.IsAccountReport && Model.AccountBalance is { } accountBalance)
{
    <section class="panel report-summary">
        <strong>@accountBalance.Account.Code · @accountBalance.Account.Name (سطح @accountBalance.Account.Level)</strong>
        <span>@(accountBalance.IncludesChildren && accountBalance.Account.HasChildren ? "با تجمیع زیرحساب‌ها" : "فقط ثبت‌های مستقیم")</span>
        <span>مانده تا @PersianDate.FormatDate(accountBalance.AsOf): @MoneyMath.FormatAmount(Math.Max(0m, accountBalance.BalanceIrr), 0) بدهکار · @MoneyMath.FormatAmount(Math.Max(0m, -accountBalance.BalanceIrr), 0) بستانکار</span>
    </section>
}
else if (Model.IsAccountReport && Model.AccountLedger is { } accountLedger)
{
    <section class="panel report-summary">
        <strong>@accountLedger.Account.Code · @accountLedger.Account.Name (سطح @accountLedger.Account.Level)</strong>
        <span>@(accountLedger.IncludesChildren && accountLedger.Account.HasChildren ? "با تجمیع زیرحساب‌ها" : "فقط ثبت‌های مستقیم")</span>
        <span>مانده‌ی اول دوره: @MoneyMath.FormatAmount(Math.Abs(accountLedger.OpeningBalanceIrr), 0) ریال @(accountLedger.OpeningBalanceIrr > 0 ? "بدهکار" : accountLedger.OpeningBalanceIrr < 0 ? "بستانکار" : "تسویه")</span>
        <span>مانده‌ی پایان دوره: @MoneyMath.FormatAmount(Math.Abs(accountLedger.ClosingBalanceIrr), 0) ریال @(accountLedger.ClosingBalanceIrr > 0 ? "بدهکار" : accountLedger.ClosingBalanceIrr < 0 ? "بستانکار" : "تسویه")</span>
    </section>
    <div class="table-wrap">
        <table>
            <thead><tr><th>زمان</th><th>شعبه</th><th>شماره سند</th><th>منشأ</th><th>شرح</th><th>کد حساب ثبت‌شده</th><th>نام حساب ثبت‌شده</th><th>بدهکار (ریال)</th><th>بستانکار (ریال)</th><th>مانده</th></tr></thead>
            <tbody>
                <tr class="summary-row">
                    <td colspan="7">مانده‌ی ابتدای دوره</td>
                    <td>@MoneyMath.FormatAmount(Math.Max(0m, accountLedger.OpeningBalanceIrr), 0)</td>
                    <td>@MoneyMath.FormatAmount(Math.Max(0m, -accountLedger.OpeningBalanceIrr), 0)</td>
                    <td>@MoneyMath.FormatAmount(Math.Abs(accountLedger.OpeningBalanceIrr), 0) @(accountLedger.OpeningBalanceIrr > 0 ? "بدهکار" : accountLedger.OpeningBalanceIrr < 0 ? "بستانکار" : "تسویه")</td>
                </tr>
                @if (accountLedger.Lines.Count == 0)
                {
                    <tr><td colspan="10">در این بازه گردش ثبت نشده است.</td></tr>
                }
                @foreach (var line in accountLedger.Lines)
                {
                    <tr>
                        <td>@PersianDate.FormatDateTime(line.OccurredAt)</td><td>@line.BranchName</td><td>@line.JournalEntryId</td>
                        <td>@IndexModel.SourceText(line.SourceType)</td><td>@(line.IsVoided ? "[باطل‌شده] " : "")@line.Description</td>
                        <td>@line.AccountCode</td><td>@line.AccountName</td><td>@MoneyMath.FormatAmount(line.Debit, 0)</td>
                        <td>@MoneyMath.FormatAmount(line.Credit, 0)</td>
                        <td>@MoneyMath.FormatAmount(Math.Abs(line.BalanceIrr), 0) @(line.BalanceIrr > 0 ? "بدهکار" : line.BalanceIrr < 0 ? "بستانکار" : "تسویه")</td>
                    </tr>
                }
                <tr class="summary-row"><td colspan="7">مانده‌ی پایان دوره</td><td>@MoneyMath.FormatAmount(Math.Max(0m, accountLedger.ClosingBalanceIrr), 0)</td><td>@MoneyMath.FormatAmount(Math.Max(0m, -accountLedger.ClosingBalanceIrr), 0)</td><td>@MoneyMath.FormatAmount(Math.Abs(accountLedger.ClosingBalanceIrr), 0) @(accountLedger.ClosingBalanceIrr > 0 ? "بدهکار" : accountLedger.ClosingBalanceIrr < 0 ? "بستانکار" : "تسویه")</td></tr>
            </tbody>
        </table>
    </div>
}
else if (Model.IsAccountReport)
{
    <div class="alert">برای مشاهده‌ی گزارش، ابتدا یک سرفصل را انتخاب کنید.</div>
}
else if (Model.IsCashBoxReport)
{
    @if (Model.CashBoxLedgers.Count == 0)
    {
        <div class="alert">صندوقی برای این فیلتر پیدا نشد.</div>
    }
    @foreach (var report in Model.CashBoxLedgers)
    {
        <section class="panel report-summary">
            <strong>@report.CashBox.BranchName · @report.CashBox.Name · @report.CashBox.CurrencyCode</strong>
            @if (report.FromInclusive is null)
            {
                <span>مانده تا @PersianDate.FormatDate(report.ToExclusive.Date.AddDays(-1)): @MoneyMath.FormatAmount(report.ClosingBalance, report.DecimalPlaces) @report.CashBox.CurrencyCode</span>
            }
            else
            {
                <span>مانده‌ی ابتدای دوره: @MoneyMath.FormatAmount(report.OpeningBalance, report.DecimalPlaces) @report.CashBox.CurrencyCode</span>
                <span>مانده‌ی پایان دوره: @MoneyMath.FormatAmount(report.ClosingBalance, report.DecimalPlaces) @report.CashBox.CurrencyCode</span>
            }
        </section>
        <div class="table-wrap">
            <table>
                <thead><tr><th>زمان</th><th>شناسه مرجع</th><th>منشأ</th><th>شرح</th><th>واریز</th><th>برداشت</th><th>مانده (@report.CashBox.CurrencyCode)</th></tr></thead>
                <tbody>
                    @if (report.FromInclusive is null)
                    {
                        <tr class="summary-row"><td colspan="4">مانده تا تاریخ انتخابی</td><td>—</td><td>—</td><td>@MoneyMath.FormatAmount(report.ClosingBalance, report.DecimalPlaces)</td></tr>
                    }
                    else
                    {
                        <tr class="summary-row"><td colspan="4">مانده‌ی ابتدای دوره</td><td>—</td><td>—</td><td>@MoneyMath.FormatAmount(report.OpeningBalance, report.DecimalPlaces)</td></tr>
                        @if (report.Lines.Count == 0)
                        {
                            <tr><td colspan="7">در این بازه گردش ثبت نشده است.</td></tr>
                        }
                        @foreach (var line in report.Lines)
                        {
                            <tr><td>@PersianDate.FormatDateTime(line.OccurredAt)</td><td>@line.ReferenceId</td><td>@IndexModel.SourceText(line.SourceType)</td><td>@line.Description</td><td>@MoneyMath.FormatAmount(Math.Max(0m, line.Amount), report.DecimalPlaces)</td><td>@MoneyMath.FormatAmount(Math.Max(0m, -line.Amount), report.DecimalPlaces)</td><td>@MoneyMath.FormatAmount(line.Balance, report.DecimalPlaces)</td></tr>
                        }
                        <tr class="summary-row"><td colspan="4">مانده‌ی پایان دوره</td><td>—</td><td>—</td><td>@MoneyMath.FormatAmount(report.ClosingBalance, report.DecimalPlaces)</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else if (Model.IsBankReport)
{
    @if (Model.BankLedgers.Count == 0)
    {
        <div class="alert">حساب بانکی برای این فیلتر پیدا نشد.</div>
    }
    @foreach (var report in Model.BankLedgers)
    {
        <section class="panel report-summary">
            <strong>@report.BankAccount.BranchName · @report.BankAccount.Name · @report.BankAccount.CurrencyCode</strong>
            @if (report.FromInclusive is null)
            {
                <span>مانده تا @PersianDate.FormatDate(report.ToExclusive.Date.AddDays(-1)): @MoneyMath.FormatAmount(report.ClosingBalance, report.BankAccount.DecimalPlaces) @report.BankAccount.CurrencyCode</span>
            }
            else
            {
                <span>مانده‌ی ابتدای دوره: @MoneyMath.FormatAmount(report.OpeningBalance, report.BankAccount.DecimalPlaces) @report.BankAccount.CurrencyCode</span>
                <span>مانده‌ی پایان دوره: @MoneyMath.FormatAmount(report.ClosingBalance, report.BankAccount.DecimalPlaces) @report.BankAccount.CurrencyCode</span>
            }
        </section>
        <div class="table-wrap">
            <table>
                <thead><tr><th>زمان</th><th>شناسه مرجع</th><th>منشأ</th><th>شرح</th><th>واریز</th><th>برداشت</th><th>مانده (@report.BankAccount.CurrencyCode)</th></tr></thead>
                <tbody>
                    @if (report.FromInclusive is null)
                    {
                        <tr class="summary-row"><td colspan="4">مانده تا تاریخ انتخابی</td><td>—</td><td>—</td><td>@MoneyMath.FormatAmount(report.ClosingBalance, report.BankAccount.DecimalPlaces)</td></tr>
                    }
                    else
                    {
                        <tr class="summary-row"><td colspan="4">مانده‌ی ابتدای دوره</td><td>—</td><td>—</td><td>@MoneyMath.FormatAmount(report.OpeningBalance, report.BankAccount.DecimalPlaces)</td></tr>
                        @if (report.Lines.Count == 0)
                        {
                            <tr><td colspan="7">در این بازه گردش ثبت نشده است.</td></tr>
                        }
                        @foreach (var line in report.Lines)
                        {
                            <tr><td>@PersianDate.FormatDateTime(line.OccurredAt)</td><td>@line.ReferenceId</td><td>@IndexModel.SourceText(line.SourceType)</td><td>@line.Description</td><td>@MoneyMath.FormatAmount(Math.Max(0m, line.Amount), report.BankAccount.DecimalPlaces)</td><td>@MoneyMath.FormatAmount(Math.Max(0m, -line.Amount), report.BankAccount.DecimalPlaces)</td><td>@MoneyMath.FormatAmount(line.Balance, report.BankAccount.DecimalPlaces)</td></tr>
                        }
                        <tr class="summary-row"><td colspan="4">مانده‌ی پایان دوره</td><td>—</td><td>—</td><td>@MoneyMath.FormatAmount(report.ClosingBalance, report.BankAccount.DecimalPlaces)</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

<script>
(() => {
    const reportType = document.getElementById('ReportType');
    const dateMode = document.getElementById('DateMode');
    const filters = document.querySelectorAll('.report-filter');
    const updateVisibility = () => {
        const type = reportType?.value || 'BALANCES';
        const mode = dateMode?.value || 'ASOF';
        for (const filter of filters) {
            const types = (filter.dataset.reportTypes || '').split(',');
            const modes = (filter.dataset.dateModes || '').split(',').filter(Boolean);
            const visible = types.includes(type) && (modes.length === 0 || modes.includes(mode));
            filter.hidden = !visible;
            for (const control of filter.querySelectorAll('input, select, textarea')) {
                control.disabled = !visible;
            }
        }
    };
    reportType?.addEventListener('change', updateVisibility);
    dateMode?.addEventListener('change', updateVisibility);
    updateVisibility();
})();
</script>
