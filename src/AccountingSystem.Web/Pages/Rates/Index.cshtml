@page
@model IndexModel
@{
    ViewData["Title"] = "نرخ‌ها و مدیریت ارز";
}

<h1>نرخ‌ها و مدیریت ارز</h1>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert ok">@successMessage</div>
}
<div asp-validation-summary="All" class="alert error"></div>

@if (Model.Notice is { } notice)
{
    <p class="alert error">@notice</p>
}
@if (Model.IsAdmin || Model.ReadableBranches.Count > 1)
{
    <form method="get" class="panel filters">
        <label>شعبه
            <select name="BranchFilter">
                @if (Model.IsAdmin)
                {
                    <option value="">همه‌ی شعبه‌ها</option>
                }
                @foreach (var b in Model.ReadableBranches)
                {
                    <option value="@b.Id" selected="@(Model.BranchFilter == b.Id)">@b.Code - @b.Name</option>
                }
            </select>
        </label>
        <div><button type="submit">نمایش</button></div>
    </form>
}

<h2>آخرین نرخ‌ها</h2>
<table>
    <thead>
        <tr>
            <th>شعبه</th>
            <th>ارز</th>
            <th>نرخ خرید از مشتری (ریال)</th>
            <th>نرخ فروش به مشتری (ریال)</th>
            <th>زمان ثبت</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.RateList)
        {
            <tr>
                <td>@r.BranchName</td>
                <td>@r.CurrencyCode - @r.CurrencyName</td>
                <td>@ViewFormat.Rate(r.BuyRateIrr)</td>
                <td>@ViewFormat.Rate(r.SellRateIrr)</td>
                <td>@ViewFormat.Date(r.CreatedAt)</td>
            </tr>
        }
    </tbody>
</table>

<h2>ثبت نرخ جدید</h2>
<form method="post" asp-page-handler="SetRate" class="panel form-grid">
    @if (Model.Branches.Count != 1)
    {
        <label>شعبه
            <select name="RateInput.BranchId">
                @foreach (var b in Model.Branches)
                {
                    <option value="@b.Id" selected="@(b.Id == Model.RateInput.BranchId)">@b.Code - @b.Name</option>
                }
            </select>
        </label>
    }
    else
    {
        <input type="hidden" name="RateInput.BranchId" value="@Model.RateInput.BranchId" />
    }
    <label>ارز
        <select name="RateInput.CurrencyCode">
            @foreach (var c in Model.Currencies)
            {
                <option value="@c.Code">@c.Code - @c.Name</option>
            }
        </select>
    </label>
    <label>نرخ خرید از مشتری (ریال)<input name="RateInput.BuyRate" dir="ltr" inputmode="decimal" /></label>
    <label>نرخ فروش به مشتری (ریال)<input name="RateInput.SellRate" dir="ltr" inputmode="decimal" /></label>
    <div><button type="submit">ثبت نرخ</button></div>
</form>

@if (Model.IsAdmin)
{
    <h2>افزودن ارز جدید</h2>
    <form method="post" asp-page-handler="AddCurrency" class="panel form-grid">
        <label>کد ارز (سه حرف انگلیسی)<input name="CurrencyInput.Code" dir="ltr" maxlength="3" /></label>
        <label>نام ارز<input name="CurrencyInput.Name" /></label>
        <label>تعداد ارقام اعشار<input name="CurrencyInput.DecimalPlaces" value="2" dir="ltr" type="number" min="0" max="4" /></label>
        <div><button type="submit">افزودن ارز</button></div>
    </form>
    <p class="hint">ارز جدید برای همه‌ی شعبه‌ها ساخته می‌شود و هر شعبه نرخ مخصوص خود را ثبت می‌کند.</p>
}
