@page
@model IndexModel
@{
    ViewData["Title"] = "داشبورد";
}

<h1>داشبورد</h1>

@if (Model.Notice is { } notice)
{
    <p class="alert error">@notice</p>
}
@if (Model.IsAdmin || Model.Branches.Count > 1)
{
    <form method="get" class="panel filters">
        <label>شعبه
            <select name="BranchFilter">
                @if (Model.IsAdmin)
                {
                    <option value="">همه‌ی شعبه‌ها</option>
                }
                @foreach (var b in Model.Branches)
                {
                    <option value="@b.Id" selected="@(Model.BranchFilter == b.Id)">@b.Code - @b.Name</option>
                }
            </select>
        </label>
        <div><button type="submit">نمایش</button></div>
    </form>
}

@if (Model.Dashboard is { } d)
{
    <section class="cards">
        <div class="card"><span>موجودی صندوق ریال</span><strong>@ViewFormat.Money(d.IrrBalance) ریال</strong></div>
        <div class="card"><span>ارزش موجودی ارزی (به نرخ فروش روز)</span><strong>@ViewFormat.Money(d.ForeignValueIrr) ریال</strong></div>
        <div class="card"><span>خرید امروز</span><strong>@d.TodayBuyCount معامله - @ViewFormat.Money(d.TodayBuyIrr) ریال</strong></div>
        <div class="card"><span>فروش امروز</span><strong>@d.TodaySellCount معامله - @ViewFormat.Money(d.TodaySellIrr) ریال</strong></div>
        <div class="card"><span>سود تحقق‌یافته امروز</span><strong>@ViewFormat.Money(d.TodayProfitIrr) ریال</strong></div>
        <div class="card"><span>درآمد کارمزد امروز</span><strong>@ViewFormat.Money(d.TodayFeeIrr) ریال</strong></div>
    </section>

    <h2>موجودی ارزی</h2>
    <table>
        <thead>
            <tr>
                <th>شعبه</th>
                <th>ارز</th>
                <th>موجودی</th>
                <th>بهای تمام‌شده (ریال)</th>
                <th>میانگین قیمت تمام‌شده</th>
                <th>نرخ فروش روز</th>
                <th>ارزش روز (ریال)</th>
                <th>سود/زیان شناور (ریال)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in d.Positions)
            {
                <tr>
                    <td>@p.BranchName</td>
                    <td>@p.CurrencyCode - @p.CurrencyName</td>
                    <td>@ViewFormat.Quantity(p.Quantity)</td>
                    <td>@ViewFormat.Money(p.CostIrr)</td>
                    <td>@ViewFormat.Money(p.AverageCostIrr, 2)</td>
                    <td>@ViewFormat.Money(p.SellRateIrr)</td>
                    <td>@ViewFormat.Money(p.ValueIrr)</td>
                    <td>@ViewFormat.Money(p.UnrealizedProfitIrr)</td>
                </tr>
            }
        </tbody>
    </table>
}
