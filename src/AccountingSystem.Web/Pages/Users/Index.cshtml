@page
@model IndexModel
@{
    ViewData["Title"] = "کاربران";
}

<h1>کاربران</h1>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert ok">@successMessage</div>
}
@if (TempData["Error"] is string errorMessage)
{
    <div class="alert error">@errorMessage</div>
}
<div asp-validation-summary="All" class="alert error"></div>

<table>
    <thead>
        <tr>
            <th>نام کاربری</th>
            <th>نام و نام خانوادگی</th>
            <th>نقش</th>
            <th>شعبه</th>
            <th>وضعیت</th>
            <th>تاریخ ثبت</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model.UserList)
        {
            <tr>
                <td>@u.Username</td>
                <td>@u.FullName</td>
                <td>@ViewFormat.RoleText(u.Role)</td>
                <td>@(u.BranchName ?? "همه‌ی شعبه‌ها")</td>
                <td>@(u.IsActive ? "فعال" : "غیرفعال")</td>
                <td>@ViewFormat.Date(u.CreatedAt)</td>
            </tr>
        }
    </tbody>
</table>

<h2>دسترسی‌های ویرایش و ابطال</h2>
<p class="hint">
    مدیر به همه‌ی دسترسی‌ها دسترسی دارد. دسترسی‌های زیر فقط به کاربر صندوق داده می‌شود و فقط برای اسناد شعبه‌ی خودش معتبر است.
    تغییر دسترسی همان لحظه اعمال می‌شود. ثبت موجودی افتتاحیه و سند دستی جدید فقط با مدیر است.
</p>
@foreach (var u in Model.UserList)
{
    @if (u.Role == UserRole.Cashier)
    {
        <form method="post" asp-page-handler="Permissions" class="panel">
            <h3>@(u.FullName) (@(u.Username)) - @(u.BranchName ?? "بدون شعبه")@(u.IsActive ? "" : " - غیرفعال")</h3>
            <input type="hidden" name="userId" value="@u.Id" />
            <div class="form-grid">
                @foreach (var permission in Model.AllPermissions)
                {
                    <label>
                        <input type="checkbox" name="permissions" value="@PermissionCodes.ToCode(permission)" checked="@Model.HasPermission(u.Id, permission)" />
                        @PermissionCodes.DisplayName(permission)
                    </label>
                }
            </div>
            <div><button type="submit">ذخیره‌ی دسترسی‌ها</button></div>
        </form>
    }
}

<h2>افزودن کاربر</h2>
<form method="post" class="panel form-grid">
    <label>نام کاربری<input name="Input.Username" dir="ltr" /></label>
    <label>نام و نام خانوادگی<input name="Input.FullName" /></label>
    <label>رمز عبور (حداقل ۶ کاراکتر)<input name="Input.Password" type="password" dir="ltr" /></label>
    <label>نقش
        <select name="Input.Role">
            <option value="Cashier">کاربر صندوق</option>
            <option value="Admin">مدیر</option>
        </select>
    </label>
    <label>شعبه (برای کاربر صندوق الزامی است)
        <select name="Input.BranchId">
            <option value="">-- انتخاب شعبه --</option>
            @foreach (var b in Model.Branches)
            {
                <option value="@b.Id">@b.Code - @b.Name</option>
            }
        </select>
    </label>
    <div><button type="submit">ثبت کاربر</button></div>
</form>
