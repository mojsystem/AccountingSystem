@page
@model IndexModel
@{
    ViewData["Title"] = "کاربران";
}

<h1>کاربران و شعبه‌ها</h1>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert ok">@successMessage</div>
}
@if (TempData["Error"] is string errorMessage)
{
    <div class="alert error">@errorMessage</div>
}
<div asp-validation-summary="All" class="alert error"></div>

<p class="hint">
    هر کاربر غیرمدیر می‌تواند در چند شعبه عضو باشد و در هر شعبه فقط یک نقش داشته باشد. نقش‌ها در صفحه‌ی «نقش‌ها» تعریف می‌شوند.
    مدیر سیستم به همه‌ی شعبه‌ها دسترسی کامل دارد و برای او نقش شعبه‌ای تعریف نمی‌شود.
</p>

@foreach (var u in Model.UserList)
{
    <section class="panel">
        <h2>@u.FullName <small>(@u.Username)</small></h2>
        <p>
            نقش سیستم: <strong>@ViewFormat.RoleText(u.Role)</strong>
            @if (!u.IsActive)
            {
                <span class="badge">غیرفعال</span>
            }
            @if (u.Role != UserRole.Admin && u.BranchName is not null)
            {
                <span>— شعبه‌ی اصلی: @u.BranchName</span>
            }
        </p>
        @if (u.Role == UserRole.Admin)
        {
            <p class="hint">مدیر سیستم به همه‌ی شعبه‌ها دسترسی کامل دارد.</p>
        }
        else
        {
            <form method="post" asp-page-handler="Memberships">
                <input type="hidden" name="userId" value="@u.Id" />
                <table>
                    <thead>
                        <tr>
                            <th>شعبه</th>
                            <th>نقش در این شعبه</th>
                            <th>شعبه‌ی اصلی</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.Branches)
                        {
                            var userAccess = Model.Access.TryGetValue(u.Id, out var found) ? found : null;
                            var branchAccess = userAccess is not null && userAccess.Branches.TryGetValue(b.Id, out var inBranch) ? inBranch : null;
                            <tr>
                                <td>@b.Code - @b.Name</td>
                                <td>
                                    <select name="role_@b.Id">
                                        <option value="">— بدون دسترسی —</option>
                                        @foreach (var r in Model.RolesByBranch[b.Id])
                                        {
                                            <option value="@r.Id" selected="@(branchAccess?.RoleId == r.Id)">@r.Name</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="radio" name="defaultBranchId" value="@b.Id" checked="@(userAccess?.DefaultBranchId == b.Id)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div><button type="submit">ذخیره‌ی شعبه‌ها و نقش‌ها</button></div>
            </form>
        }
    </section>
}

<h2>افزودن کاربر</h2>
<form method="post" class="panel form-grid">
    <label>نام کاربری<input name="Input.Username" dir="ltr" /></label>
    <label>نام و نام خانوادگی<input name="Input.FullName" /></label>
    <label>رمز عبور (حداقل ۶ کاراکتر)<input name="Input.Password" type="password" dir="ltr" /></label>
    <label>نوع کاربر
        <select name="Input.Role">
            <option value="Cashier">کاربر شعبه</option>
            <option value="Admin">مدیر سیستم</option>
        </select>
    </label>
    <label>شعبه‌ی اصلی (برای کاربر شعبه الزامی است)
        <select name="Input.BranchId">
            <option value="">-- انتخاب شعبه --</option>
            @foreach (var b in Model.Branches)
            {
                <option value="@b.Id">@b.Code - @b.Name</option>
            }
        </select>
    </label>
    <div><button type="submit">ثبت کاربر</button></div>
</form>
