@page
@model IndexModel
@{
    ViewData["Title"] = "اسناد حسابداری";
}

<h1>اسناد حسابداری</h1>

<form method="get" class="panel filters">
    <label>از تاریخ (شمسی)<input name="From" value="@Model.From" dir="ltr" placeholder="۱۴۰۵/۰۷/۰۱" /></label>
    <label>تا تاریخ (شمسی)<input name="To" value="@Model.To" dir="ltr" placeholder="۱۴۰۵/۰۷/۳۰" /></label>
    @if (Model.IsAdmin)
    {
        <label>شعبه
            <select name="BranchFilter">
                <option value="">همه‌ی شعبه‌ها</option>
                @foreach (var b in Model.Branches)
                {
                    <option value="@b.Id" selected="@(Model.BranchFilter == b.Id)">@b.Code - @b.Name</option>
                }
            </select>
        </label>
    }
    <div><button type="submit">نمایش</button></div>
    <div><a class="link-button" asp-page-handler="Excel" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-branchFilter="@Model.BranchFilter">خروجی Excel</a></div>
</form>

@if (Model.RangeError is { } rangeError)
{
    <div class="alert error">@rangeError</div>
}

@if (Model.Entries.Count == 0)
{
    <p>سندی در این بازه ثبت نشده است.</p>
}

@foreach (var entry in Model.Entries)
{
    <div class="entry">
        <h3>سند شماره @entry.Id - @ViewFormat.Date(entry.OccurredAt) - @entry.BranchName - @entry.Description</h3>
        <table>
            <thead>
                <tr>
                    <th>ردیف</th>
                    <th>کد حساب</th>
                    <th>نام حساب</th>
                    <th>بدهکار (ریال)</th>
                    <th>بستانکار (ریال)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in entry.Lines)
                {
                    <tr>
                        <td>@line.LineNo</td>
                        <td>@line.AccountCode</td>
                        <td>@line.AccountName</td>
                        <td>@ViewFormat.Money(line.Debit)</td>
                        <td>@ViewFormat.Money(line.Credit)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
